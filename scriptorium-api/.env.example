# Server
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=change-this-to-a-random-secret

# Database (pick one)
# Option 1: SQLite (default — no config needed, uses data/scriptorium.db)
# Option 2: PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/scriptorium
# Option 3: Vercel KV
# KV_REST_API_URL=https://your-kv-instance.upstash.io
# KV_REST_API_TOKEN=your-kv-token

# Email (optional; 'log' prints to console)
EMAIL_PROVIDER=log
EMAIL_FROM=scriptorium@updates.scriptorium.app
# RESEND_API_KEY=re_xxx

# Scripture API (optional; for NIV/ESV via api.scripture.api.bible)
SCRIPTURE_API_KEY=
